&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            7.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND Cl
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_114_s_p_d_f_g_h_i_7_6_5_4_4_0_0_error_2.6e-05
      POTENTIAL ALL
     &END KIND

     &KIND C
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_060_s_p_d_f_g_h_i_7_5_3_2_1_0_0_error_4.4e-05
      POTENTIAL ALL
     &END KIND

     &KIND N
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_056_s_p_d_f_g_h_i_6_4_3_2_1_0_0_error_6.6e-05
      POTENTIAL ALL
     &END KIND

     &KIND H
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_009_s_p_d_f_g_h_i_3_2_0_0_0_0_0_error_4.4e-05
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     Cl 17.13268453 12.96575000 20.53776062
     C 20.60014199 12.96575000 17.58478988
     C 20.04967105 11.75938636 18.05166059
     C 20.04967105 14.17211364 18.05166059
     N 21.62032850 12.96575000 16.63492406
     H 20.45443070 10.80868802 17.70105377
     H 22.18436262 13.80732395 16.59500272
     H 22.18436262 12.12417605 16.59500272
     C 18.98955190 11.75693744 18.95370409
     C 18.98955190 14.17456256 18.95370409
     C 18.45983297 12.96575000 19.40449850
     H 18.57416212 10.81542066 19.30883078
     H 20.45443070 15.12281198 17.70105378
     H 18.57416212 15.11607934 19.30883078
&END COORD
  &END SUBSYS
&END FORCE_EVAL
