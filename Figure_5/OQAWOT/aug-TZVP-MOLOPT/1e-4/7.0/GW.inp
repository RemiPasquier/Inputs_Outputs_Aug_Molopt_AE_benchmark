&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/metdyn02_Remi/02_TMD/BASIS_AUG_MOLOPT/aug-cc-pVZ-TOTRI
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            7.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND F
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_092_s_p_d_f_g_h_i_7_5_4_3_2_1_0_error_2.5e-05
      POTENTIAL ALL
     &END KIND

     &KIND O
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_084_s_p_d_f_g_h_i_7_4_3_3_2_1_0_error_6.7e-05
      POTENTIAL ALL
     &END KIND

     &KIND N
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_081_s_p_d_f_g_h_i_7_5_4_3_2_0_0_error_5.6e-05
      POTENTIAL ALL
     &END KIND

     &KIND H
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_023_s_p_d_f_g_h_i_4_3_2_0_0_0_0_error_4.6e-05
      POTENTIAL ALL
     &END KIND

     &KIND C
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_073_s_p_d_f_g_h_i_7_4_3_3_2_0_0_error_4.5e-05
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     F 11.72209934 26.48945392 19.91184316
     F 13.84347067 27.01351447 19.76144349
     O 10.23390459 25.08989819 23.65062915
     N 11.96497917 26.38016085 22.82987730
     H 11.62597887 27.25045148 23.22525009
     C 11.23869796 25.21418117 22.97463735
