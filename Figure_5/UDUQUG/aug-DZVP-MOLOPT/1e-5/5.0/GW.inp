&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            5.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND C
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_067_s_p_d_f_g_h_i_7_5_3_3_1_0_0_error_8.9e-06
      POTENTIAL ALL
     &END KIND

     &KIND H
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_018_s_p_d_f_g_h_i_4_3_1_0_0_0_0_error_6.3e-07
      POTENTIAL ALL
     &END KIND

     &KIND O
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_072_s_p_d_f_g_h_i_7_5_4_3_1_0_0_error_4.9e-06
      POTENTIAL ALL
     &END KIND

     &KIND N
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_068_s_p_d_f_g_h_i_6_5_3_2_2_0_0_error_9.7e-06
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     C 28.48517845 37.56791464 18.45631678
     H 27.40857747 37.71645350 18.30773427
     H 28.95804194 37.37290283 17.48955545
     C 28.29342450 36.30095310 20.63442730
     O 27.58379650 37.30093228 21.16949627
     C 27.17575117 37.07707793 22.53597948
     H 28.05414667 36.94691150 23.18035596
     H 26.54422047 36.18250086 22.60422310
     H 26.61494557 37.97161134 22.81879509
     N 28.72483486 36.43198571 19.33193498
     H 28.91193598 38.48113959 18.88876521
     N 28.65193537 35.16895594 21.19293383
     C 29.35211072 34.53306455 20.20075471
     N 29.94084268 33.22962133 20.38382177
     O 29.80352634 32.67651897 21.47505066
     O 30.55112643 32.75804940 19.41002883
     C 29.41766533 35.27739430 19.04467893
     H 29.88055842 35.08606687 18.08601496
&END COORD
  &END SUBSYS
&END FORCE_EVAL
