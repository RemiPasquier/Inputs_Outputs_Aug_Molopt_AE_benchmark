&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/metdyn02_Remi/02_TMD/BASIS_AUG_MOLOPT/aug-cc-pVZ-TOTRI
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            7.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND C
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_048_s_p_d_f_g_h_i_6_3_2_2_1_0_0_error_6.0e-04
      POTENTIAL ALL
     &END KIND

     &KIND H
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_015_s_p_d_f_g_h_i_4_2_1_0_0_0_0_error_5.9e-04
      POTENTIAL ALL
     &END KIND

     &KIND N
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_055_s_p_d_f_g_h_i_7_5_2_2_1_0_0_error_9.9e-04
      POTENTIAL ALL
     &END KIND

     &KIND S
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_107_s_p_d_f_g_h_i_7_6_5_4_2_1_0_error_4.9e-04
      POTENTIAL ALL
     &END KIND

     &KIND O
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_066_s_p_d_f_g_h_i_7_4_3_2_2_0_0_error_9.4e-04
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     C 16.83823222 15.54750670 18.97411925
     H 17.83932404 19.63018501 19.28584050
     N 16.63113334 14.68299616 17.93624563
     H 15.85713279 14.03445241 18.01495841
     H 17.02347467 14.86337940 17.02118441
     S 18.06129256 16.81559233 18.55913711
     C 18.17543441 17.66729972 20.18623740
     H 17.15431181 17.60936868 20.58782193
     C 19.13575530 16.94697472 21.12962980
     H 20.15645337 16.93268917 20.72312902
     H 18.81541244 15.91388531 21.30716316
     H 19.16250052 17.46451265 22.10068217
     C 18.56648624 19.12275148 19.93164611
     H 18.61339600 19.66255151 20.88803807
     H 19.55686182 19.20006641 19.46076157
     O 16.27330069 15.46331383 20.05176006
&END COORD
  &END SUBSYS
&END FORCE_EVAL
