&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            9.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND H
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_018_s_p_d_f_g_h_i_4_3_1_0_0_0_0_error_6.3e-07
      POTENTIAL ALL
     &END KIND

     &KIND N
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_068_s_p_d_f_g_h_i_6_5_3_2_2_0_0_error_9.7e-06
      POTENTIAL ALL
     &END KIND

     &KIND C
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_067_s_p_d_f_g_h_i_7_5_3_3_1_0_0_error_8.9e-06
      POTENTIAL ALL
     &END KIND

     &KIND Cl
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_114_s_p_d_f_g_h_i_7_6_5_4_4_0_0_error_2.6e-05
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     H 23.07802240 31.45289464 30.42420332
     H 22.86611327 29.72010572 30.75676765
     N 25.06116972 29.54264134 26.47159260
     C 25.21315036 28.71570143 27.47998094
     Cl 26.05555564 27.20323146 27.14661599
     C 24.76521040 28.93547881 28.80176100
     N 24.91394930 27.98214323 29.78897820
     H 25.58335242 27.24662383 29.58626646
     H 24.92016754 28.30564716 30.74863335
     C 24.10217312 30.16061240 29.03984146
     C 23.94488583 31.03985243 27.96670573
     H 23.43702723 31.99284586 28.11872849
     C 24.42967689 30.70274914 26.70621445
     H 24.31636710 31.37388146 25.85386786
     C 23.58332722 30.48089322 30.41152700
     H 24.39505410 30.52254633 31.15651976
&END COORD
  &END SUBSYS
&END FORCE_EVAL
