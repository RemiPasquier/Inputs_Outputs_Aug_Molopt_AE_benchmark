     H 22.98374193 19.81908385 16.75862369
     H 21.80106573 19.43300418 18.04060707
     F 24.62643916 23.70137844 16.09970267
     H 23.79129320 21.82941589 16.92044245
     C 24.15260974 23.21532327 18.37092257
