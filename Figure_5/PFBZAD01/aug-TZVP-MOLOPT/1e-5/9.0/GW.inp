&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    BASIS_SET_FILE_NAME /scratch/hpc-prf-metdyn/metdyn02_Remi/02_TMD/BASIS_AUG_MOLOPT/aug-cc-pVZ-TOTRI
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            9.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND F
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_109_s_p_d_f_g_h_i_7_6_5_3_3_1_0_error_1.0e-05
      POTENTIAL ALL
     &END KIND

     &KIND O
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_119_s_p_d_f_g_h_i_7_6_6_5_2_1_0_error_5.1e-06
      POTENTIAL ALL
     &END KIND

     &KIND C
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_084_s_p_d_f_g_h_i_7_6_4_3_2_0_0_error_6.6e-06
      POTENTIAL ALL
     &END KIND

     &KIND H
      BASIS_SET ORB aug-TZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-TZVP-MOLOPT-ae_N_RI_031_s_p_d_f_g_h_i_6_5_2_0_0_0_0_error_4.5e-06
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     F 43.44451226 45.86846537 49.72450775
     O 48.83585322 48.76797942 51.17743266
     C 46.51314046 48.34108989 50.91822350
     C 45.17948051 48.75172348 51.06112223
     C 44.13760863 47.92321815 50.66067119
     C 44.45243740 46.68088905 50.11672809
     C 45.76386644 46.24264311 49.96093655
     C 46.79704425 47.08272510 50.36620275
     C 47.57909351 49.27174243 51.36482013
     H 44.97872309 49.73158490 51.49170830
     H 43.09562257 48.22120825 50.76216674
     H 45.95838099 45.26217442 49.53001795
