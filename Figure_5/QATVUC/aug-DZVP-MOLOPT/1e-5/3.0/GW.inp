&GLOBAL
  PROJECT  MoS2
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY
  &TIMINGS
     THRESHOLD 0.0001
  &END
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
   &DFT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_AUG_MOLOPT
    BASIS_SET_FILE_NAME /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/BASIS_RI_AUG_MOLOPT
    SORT_BASIS EXP
    POTENTIAL_FILE_NAME  /pc2/groups/hpc-prf-metdyn/metdyn02_Remi/cp2k_Otus/01_CP2K/cp2k/data/ALL_POTENTIALS 
    CHARGE 0
    &MGRID
      CUTOFF  500
      REL_CUTOFF  100
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &QS
      METHOD GAPW
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-12
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 500
      &PRINT
        &RESTART ON
        &END
      &END
      ADDED_MOS -1
      &MIXING
          METHOD BROYDEN_MIXING
          ALPHA 0.1
          BETA 1.5
          NBROYDEN 8
      &END
      CHOLESKY OFF
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
      &HF
         &MEMORY
          MAX_MEMORY 16000
         &END MEMORY
      &END HF
    &END XC
    &PRINT
    &OVERLAP_CONDITION ON
    DIAGONALIZATION T
    &END OVERLAP_CONDITION
    &END PRINT
  &END DFT
  &PROPERTIES
    &BANDSTRUCTURE
      &GW
        NUM_TIME_FREQ_POINTS         30
        MEMORY_PER_PROC              16
        EPS_FILTER              1.0E-11
        REGULARIZATION_RI        1.0E-2
CUTOFF_RADIUS_RI            3.0
      &END
    &END
  &END PROPERTIES

    &SUBSYS
    &CELL
      ABC                 30 30 30
      ALPHA_BETA_GAMMA    90 90 90
      PERIODIC NONE
    &END CELL

     &KIND H
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_018_s_p_d_f_g_h_i_4_3_1_0_0_0_0_error_6.3e-07
      POTENTIAL ALL
     &END KIND

     &KIND N
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_068_s_p_d_f_g_h_i_6_5_3_2_2_0_0_error_9.7e-06
      POTENTIAL ALL
     &END KIND

     &KIND C
      BASIS_SET ORB aug-DZVP-MOLOPT-ae
      BASIS_SET RI_AUX RI_aug-DZVP-MOLOPT-ae_N_RI_067_s_p_d_f_g_h_i_7_5_3_3_1_0_0_error_8.9e-06
      POTENTIAL ALL
     &END KIND

    




    &TOPOLOGY
     &CENTER_COORDINATES T
     &END CENTER_COORDINATES
    &END TOPOLOGY


    &COORD
     H 22.62460888 26.00326472 23.19490484
     N 22.68219833 25.80649876 24.19532298
     H 22.62450884 24.79126340 24.28938439
     C 23.95379286 26.29652167 24.73816161
     H 23.95297924 27.39432353 24.64359938
     H 23.95329895 26.08976613 25.82045350
     H 27.85139112 26.00326472 23.19490484
     H 25.23800000 25.94426167 23.02816794
     N 27.79380167 25.80649876 24.19532298
     H 27.85149116 24.79126340 24.28938439
     C 26.52220714 26.29652167 24.73816161
     H 26.52302076 27.39432353 24.64359938
     H 26.52270105 26.08976613 25.82045350
     C 25.23800000 25.73171939 24.11169032
     H 25.23800000 24.63204882 24.21137945
&END COORD
  &END SUBSYS
&END FORCE_EVAL
